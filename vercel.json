{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        }
      ]
    }
  ],
  "functions": {
    "api/capobottega.js": {
      "maxDuration": 60
    },
    "api/workshop-plan.js": {
      "maxDuration": 120
    }
  }
}
